# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Database
# For Local Offline Development (default SQLite):
DATABASE_URL=sqlite:///scented_bubbles.db

# For Live Instant Cloud Sync with Supabase:
# Set this to your Supabase PostgreSQL connection string to share data instantly between cloud & local!
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Storage backend: local (dev) or supabase / cloudinary / s3
STORAGE_BACKEND=local
UPLOAD_FOLDER=app/static/uploads

# Supabase Storage Configuration (for live cloud media sync)
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-KEY]
# SUPABASE_BUCKET=media

# Store & Notifications
# Default brand is seeded as "Scented Bubbles" in the database
SUPPORT_WHATSAPP=919876543210
NOTIFICATION_EMAIL=owner@scentedbubbles.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
